{
  "name": "@zesun33/mcp-cocotb",
  "version": "0.2.0",
  "description": "Model Context Protocol (MCP) server for Python-based Cocotb hardware testbenches",
  "type": "module",
  "bin": {
    "mcp-cocotb": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "tsx --test tests/**/*.test.ts",
    "test:unit": "tsx --test tests/xml.test.ts tests/discovery.test.ts tests/contract.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "fast-xml-parser": "^4.5.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
